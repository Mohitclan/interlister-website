# Public URL of this marketing site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://interlister.panscience.ai
# Base URL of the InterLister app (live instance; http://localhost:3000 for a local app)
NEXT_PUBLIC_APP_URL=https://interlister.panscience.ai
# Business name shown in the footer. Use the name registered with Razorpay (KYC).
NEXT_PUBLIC_COMPANY_NAME=PanScience
# Optional support email, listed in the footer when set
NEXT_PUBLIC_CONTACT_EMAIL=
# Policy pages default to the app's public pages (<APP_URL>/terms etc.).
# Set any of these only if a page lives somewhere else.
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_REFUND_URL=
NEXT_PUBLIC_CONTACT_URL=
# Optional docs link in the footer
NEXT_PUBLIC_DOCS_URL=
# Build-time only. On the shared domain, build with ASSET_PREFIX=/_site so this
# site's /_next assets don't collide with the app's (see next.config.ts).
ASSET_PREFIX=
